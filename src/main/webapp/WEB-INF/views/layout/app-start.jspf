<%@ include file="/WEB-INF/views/layout/head.jspf" %>
<body>
<div class="wrapper">
    <nav id="sidebar" class="sidebar js-sidebar">
        <div class="sidebar-content js-simplebar">
            <a class="sidebar-brand" href="${ctx}${sessionScope.authUser.role.dashboardPath}">
                <i class="bi bi-droplet-fill text-danger me-1"></i><span class="align-middle">MedConnect</span>
            </a>
            <ul class="sidebar-nav">
                <c:choose>
                    <c:when test="${sessionScope.authUser.role == 'DONNEUR'}">
                        <li class="sidebar-header">Espace donneur</li>
                        <li class="sidebar-item ${activeMenu == 'dashboard' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/donneur/dashboard"><i class="bi bi-speedometer2"></i> <span class="align-middle">Tableau de bord</span></a>
                        </li>
                        <li class="sidebar-item ${activeMenu == 'annonces' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/donneur/annonces"><i class="bi bi-megaphone"></i> <span class="align-middle">Demandes de sang</span></a>
                        </li>
                        <li class="sidebar-item ${activeMenu == 'reponses' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/donneur/reponses"><i class="bi bi-hand-thumbs-up"></i> <span class="align-middle">Mes réponses</span></a>
                        </li>
                        <li class="sidebar-item ${activeMenu == 'dons' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/donneur/dons"><i class="bi bi-clock-history"></i> <span class="align-middle">Historique des dons</span></a>
                        </li>
                        <li class="sidebar-item ${activeMenu == 'profil' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/donneur/profil"><i class="bi bi-person"></i> <span class="align-middle">Mon profil</span></a>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <li class="sidebar-header">Espace hôpital</li>
                        <li class="sidebar-item ${activeMenu == 'dashboard' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/hopital/dashboard"><i class="bi bi-speedometer2"></i> <span class="align-middle">Tableau de bord</span></a>
                        </li>
                        <li class="sidebar-item ${activeMenu == 'demandes' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/hopital/demandes"><i class="bi bi-clipboard2-pulse"></i> <span class="align-middle">Demandes de sang</span></a>
                        </li>
                        <li class="sidebar-item ${activeMenu == 'dons' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/hopital/dons"><i class="bi bi-droplet-half"></i> <span class="align-middle">Dons reçus</span></a>
                        </li>
                        <li class="sidebar-item ${activeMenu == 'profil' ? 'active' : ''}">
                            <a class="sidebar-link" href="${ctx}/hopital/profil"><i class="bi bi-building"></i> <span class="align-middle">Profil de l'hôpital</span></a>
                        </li>
                    </c:otherwise>
                </c:choose>
            </ul>
            <form method="post" action="${ctx}/logout" class="sidebar-logout">
                <%@ include file="/WEB-INF/views/layout/csrf.jspf" %>
                <button type="submit" class="btn btn-outline-light btn-sm w-100"><i class="bi bi-box-arrow-right me-1"></i> Déconnexion</button>
            </form>
        </div>
    </nav>

    <div class="main">
        <nav class="navbar navbar-expand navbar-light navbar-bg">
            <a class="sidebar-toggle js-sidebar-toggle"><i class="hamburger align-self-center"></i></a>
            <div class="navbar-collapse collapse">
                <ul class="navbar-nav navbar-align">
                    <li class="nav-item">
                        <span class="nav-link text-dark">
                            <i class="bi bi-person-circle me-1"></i><c:out value="${sessionScope.authUser.displayName}"/>
                            <span class="badge bg-light text-dark ms-1">${sessionScope.authUser.role == 'DONNEUR' ? 'Donneur' : 'Hôpital'}</span>
                        </span>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="content">
            <div class="container-fluid p-0">
                <%@ include file="/WEB-INF/views/layout/flash.jspf" %>
